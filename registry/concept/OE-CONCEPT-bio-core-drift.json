  "definitions": {
    "de": {
      "biology": "Zufällige Schwankung der Allelfrequenzen innerhalb einer Population von einer Generation zur nächsten, unabhängig von einem Selektionsvorteil.\n"
    },
    "en": {
      "biology": "Random fluctuation of allele frequencies within a population from one generation to the next, independent of selective advantage.\n"
    }
